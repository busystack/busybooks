# Build-local correction: gdk_event_free owns event->button.window.
# Never modify the shared SDK/pub cache. Applies only to the pinned source form.
if(TARGET yaru_window_linux_plugin)
  get_target_property(yaru_sources yaru_window_linux_plugin SOURCES)
  set(patched_sources)
  foreach(source IN LISTS yaru_sources)
    if(source MATCHES "(^|/)yaru_window\\.cc$")
      if(IS_ABSOLUTE "${source}")
        set(original "${source}")
      else()
        get_target_property(plugin_dir yaru_window_linux_plugin SOURCE_DIR)
        set(original "${plugin_dir}/${source}")
      endif()
      file(READ "${original}" contents)
      string(REPLACE "event->button.window = handle;" "event->button.window = GDK_WINDOW(g_object_ref(handle));" contents "${contents}")
      file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/busybooks_patches")
      file(WRITE "${CMAKE_BINARY_DIR}/busybooks_patches/yaru_window.cc" "${contents}")
      list(APPEND patched_sources "${CMAKE_BINARY_DIR}/busybooks_patches/yaru_window.cc")
      get_filename_component(original_dir "${original}" DIRECTORY)
      target_include_directories(yaru_window_linux_plugin PRIVATE "${original_dir}")
    else()
      list(APPEND patched_sources "${source}")
    endif()
  endforeach()
  set_property(TARGET yaru_window_linux_plugin PROPERTY SOURCES ${patched_sources})
endif()
