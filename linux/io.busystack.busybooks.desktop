[Desktop Entry]
Type=Application
Name=BusyBooks
Comment=Offline EPUB, PDF, FB2 and comic reader with collections and Notebook
Exec=busybooks %F
Icon=io.busystack.busybooks
Terminal=false
Categories=Office;Viewer;Literature;
MimeType=application/epub+zip;application/pdf;application/x-fictionbook+xml;application/x-zip-compressed-fb2;application/vnd.comicbook+zip;application/vnd.comicbook-rar;
StartupNotify=true
StartupWMClass=io.busystack.busybooks
