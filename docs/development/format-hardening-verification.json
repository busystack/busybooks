  "findings": [
    {
      "id": "F18",
      "priority": "P1",
      "status": "fixed",
      "correction": "EPUB inspection reads bounded metadata from a file-backed ZIP directory. Cache extraction streams one resource at a time with backpressure, CRC, SHA-256 and actual-size checks, without retaining compressed book bytes or a decompressed Archive."
    },
    {
      "id": "F19",
      "priority": "P1",
      "status": "fixed",
      "correction": "PDF native resources use a SHA-256-verified content-addressed snapshot. Preparation returns the final verified source instance and stat. Watching starts before native opening and always polls physical identity, size, modification and change times alongside native events."
    },
    {
      "id": "F20",
      "priority": "P2",
      "status": "fixed",
      "correction": "Large events and commands use bounded session-owned transfers. Normal commands retain immediate delivery; multi-frame transfers own the channel until complete. Locations omit passage text, new PDF segments store UTF-16 length, and legacy text-bearing anchors remain valid. Incomplete transfers and explicit native bridge errors fail flushing."
    },
    {
      "id": "F21",
      "priority": "P2",
      "status": "fixed",
      "correction": "Cache resource digests, sealed indices, exact physical file sets and format-specific descriptor closure are checked before reuse. Fetch-time WebCrypto verifies resource digests again. The first renderer cache/resource parsing failure forces one regeneration; manual Retry also forces rebuilding. Encoded EPUB paths are decoded once after resolving path and fragment components."
    },
    {
      "id": "F22",
      "priority": "P2",
      "status": "fixed",
      "correction": "Geometry and EXIF share one bounded JPEG marker iterator, including repeated marker fill and standalone markers. Comic orientation and centered landscape classification agree with native decoding."
    }
  ],
